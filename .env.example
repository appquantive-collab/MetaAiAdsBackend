PORT=3000
# Claude reasoning layer. Without a key the app uses a deterministic offline fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Meta Ads AI module ---
# Leave META_DRY_RUN=true until the app is Meta-approved and real tokens exist.
META_DRY_RUN=true
META_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Public https URL of this server. Register PUBLIC_URL/api/meta/callback as a Valid OAuth Redirect URI in the Meta app.
PUBLIC_URL=http://localhost:3000
# 32-byte key, hex or base64, used to encrypt stored Meta tokens (AES-256-GCM).
TOKEN_ENC_KEY=

DB_PATH=./data/app.db

# --- Platform auth ---
# Set a long random AUTH_SECRET in production.
AUTH_SECRET=
# AppQuantive staff admin, seeded on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SIGNUP_OPEN=true
